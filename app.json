{
  "expo": {
    "name": "Paznwise",
    "slug": "paznwise",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-app.svg",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0D1B2A",
    "splash": {
      "image": "./assets/images/icon-app.svg",
      "resizeMode": "contain",
      "backgroundColor": "#0D1B2A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.paznwise.app"
    },
    "android": {
      "package": "com.paznwise.app",
      "statusBarColor": "#0D1B2A"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Paznwise to access your photos to upload product images.",
          "cameraPermission": "Allow Paznwise to use your camera to take product photos."
        }
      ]
    ],
    "scheme": "paznwise",
    "experiments": {
      "typedRoutes": true
    }
  }
}
