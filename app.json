{
  "expo": {
    "name": "Paznwise",
    "slug": "paznwise",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-app.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0D1B2A",
    "splash": {
      "image": "./assets/images/icon-app.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D1B2A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.paznwise.app"
    },
    "android": {
      "package": "com.paznwise.app",
      "statusBarColor": "#0D1B2A",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Paznwise to access your photos to upload product images.",
          "cameraPermission": "Allow Paznwise to use your camera to take product photos."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "scheme": "paznwise",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "316c43de-fa2a-4f41-924d-3e4dce68b859"
      },
      "apiBaseUrl": "https://paznwise.gujberry.com",
      "mediaBaseUrl": "https://bucket-6ywfl4.s3.ap-south-1.amazonaws.com",
      "appEnv": "production"
    }
  }
}
